# Environment for the SILO console service, loaded by systemd via
# EnvironmentFile=/etc/default/console (see console.service).

# Extra command line options passed to `silo-console server`, e.g. "--port 8443"
CONSOLE_OPTS=""

# Passphrase and salt used to derive the key that encrypts the JWT session
# payload. When unset, a random value is generated at startup: the console
# still works, but every service restart invalidates all active sessions.
# Set both to stable secret values to keep sessions across restarts.
#CONSOLE_PBKDF_PASSPHRASE=CHANGEME
#CONSOLE_PBKDF_SALT=CHANGEME

# SILO or MinIO-compatible server endpoint (compatibility variable retained)
#CONSOLE_MINIO_SERVER=http://localhost:9000
